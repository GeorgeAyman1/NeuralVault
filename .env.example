# NeuralVault configuration — copy to .env and fill in.
# All variables are optional; /memory/chat needs a key for the chosen provider.

# LLM provider: "anthropic" (default) or "groq" (free, OpenAI-compatible).
NEURALVAULT_LLM_PROVIDER=anthropic

# Anthropic API key — enables LLM-grounded chat when provider=anthropic.
# Without a key for the active provider, the service still runs (ingestion,
# search, memory management) but /memory/chat returns 503.
ANTHROPIC_API_KEY=

# Groq API key — free at https://console.groq.com (provider=groq).
GROQ_API_KEY=

# LLM settings. Model default is provider-aware if left unset
# (claude-opus-4-8 for anthropic, llama-3.3-70b-versatile for groq).
NEURALVAULT_LLM_MODEL=
NEURALVAULT_LLM_MAX_TOKENS=4096
# OpenAI-compatible base URL (groq default: https://api.groq.com/openai/v1).
NEURALVAULT_LLM_BASE_URL=

# Retrieval defaults
NEURALVAULT_DEFAULT_TOP_K=5
NEURALVAULT_MAX_CONTEXT_CHARS=8000

# Storage paths
NEURALVAULT_DB_PATH=data/embeddings/vectors.npy
NEURALVAULT_INDEX_PATH=data/indexes/memory_ivf

# Logging
NEURALVAULT_LOG_LEVEL=INFO
