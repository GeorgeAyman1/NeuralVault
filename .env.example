# NeuralVault configuration — copy to .env and fill in.
# All variables are optional except ANTHROPIC_API_KEY (required for /memory/chat).

# Anthropic API key — enables LLM-grounded chat. Without it, the service runs
# (ingestion, search, memory management) but /memory/chat returns 503.
ANTHROPIC_API_KEY=

# LLM settings
NEURALVAULT_LLM_MODEL=claude-opus-4-8
NEURALVAULT_LLM_MAX_TOKENS=4096

# Retrieval defaults
NEURALVAULT_DEFAULT_TOP_K=5
NEURALVAULT_MAX_CONTEXT_CHARS=8000

# Storage paths
NEURALVAULT_DB_PATH=data/embeddings/vectors.npy
NEURALVAULT_INDEX_PATH=data/indexes/memory_ivf

# Logging
NEURALVAULT_LOG_LEVEL=INFO
